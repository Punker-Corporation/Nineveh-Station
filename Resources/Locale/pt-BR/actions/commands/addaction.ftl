# addaction
cmd-addaction-desc = Adiciona uma ação à entidade alvo. A ação não funcionará se o alvo exigir um componente adicional em sua entidade (como o Devor do Dragão).
cmd-addaction-help = addaction <EntityUid> <ActionPrototype>

cmd-addaction-invalid-args = Esperava exatamente 2 argumentos.
cmd-addaction-actions-not-found = A entidade alvo não pode usar ações.
cmd-addaction-action-not-found = Não foi possível encontrar o protótipo de ação correspondente {$action}.
cmd-addaction-adding-failed = Não foi possível adicionar a ação.

cmd-addaction-player-completion = <EntityUid>
cmd-addaction-action-completion = <Proto>
