parcel-wrap-verb-wrap = Quebrar
parcel-wrap-verb-unwrap = Descompactar

parcel-wrap-popup-parcel-destroyed = A embalagem contendo { THE($contents) } é destruída!
parcel-wrap-popup-being-wrapped = {CAPITALIZE(THE($user))} está tentando embrulhá-lo!
parcel-wrap-popup-being-wrapped-self = Começas a embrulhar-te.

# Mostrado quando o wrap da encomenda é examinado no intervalo de detalhes
parcel-wrap-examine-detail-uses = { $uses ->
    [one] Há [color={$markupUsesColor}] {$uses} [/color] uso esquerdo
    *[other] Existem [color={$markupUsesColor}] {$uses} [/color] usa esquerda
}.
