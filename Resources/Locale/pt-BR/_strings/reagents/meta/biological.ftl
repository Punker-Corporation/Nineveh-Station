reagent-name-fat = gordura
reagent-desc-fat = Não importa como foi obtido, sua aplicação é importante.

reagent-name-vomit = vómito
reagent-desc-vomit = Dá para ver alguns pedaços da última refeição de alguém.

reagent-name-grey-matter = matéria cinzenta
reagent-desc-grey-matter = Sumo de pensamento, as coisas que saem dos teus ouvidos.
