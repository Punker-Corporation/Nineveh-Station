set-game-preset-command-description = Define a predefinição do jogo para o número especificado de próximas rodadas. Também pode exibir outro título e descrição predefinidos no lobby para enganar os jogadores.
set-game-preset-command-help-text = setgamepreset <id> [number of rounds, defaulting to 1] [decoy preset]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [number of rounds]
set-game-preset-command-hint-3 = [decoy preset]

set-game-preset-optional-argument-not-integer = Se o argumento 2 é fornecido deve ser um número.
set-game-preset-preset-error = Não foi possível encontrar o jogo predefinido "{$preset}"
set-game-preset-decoy-error = Se o argumento 3 for fornecido, deve ser uma predefinição válida. Não foi possível encontrar o jogo predefinido "{$preset}"

#set-game-preset-preset-set = Definir jogo predefinido para "{$preset}"
set-game-preset-preset-set-finite = Definir o jogo predefinido como "{$preset}"para o próximo {$rounds} rounds.
set-game-preset-preset-set-finite-with-decoy = Definir o jogo predefinido como "{$preset}"para o próximo {$rounds} rodadas, mostrando {$decoy} No átrio.
