cmd-removeextracomponents-desc = Remove todos os componentes de todas as entidades do ID especificado se esse componente não estiver no seu protótipo. \nIf nenhum id é especificado, ele corresponde a todas as entidades.
cmd-removeextracomponents-help = removerextracomponentes / removerextracomponentes <entidade Id>
cmd-removeextracomponents-invalid-prototype-id = Não é possível encontrar o protótipo da entidade com o id {$id}.
cmd-removeextracomponents-success = Componentes {$count} removidos de {$entities},
cmd-removeextracomponents-success-with-id = Componentes {$count} removidos de {$entities} com id {$id}.
