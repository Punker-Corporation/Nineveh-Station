cmd-pauseatmos-desc = Pausa ou despausa a simulação de atmosfera para a entidade de grade fornecida.
cmd-pauseatmos-help = Uso: {$command} <EntityUid>

cmd-pauseatmos-set-atmos-simulation = Defina simulação atmosférica em {$grid} para o estado {$state}.

cmd-pauseatmos-completion-grid-pause = EntityUid da grade que você deseja pausar /unpause. Automaticamente usa a grade que você está em pé se estiver vazio.
