cmd-showaccessreaders-desc = Permite a exibição dos direitos do leitor de acesso no cartão.
cmd-showaccessreaders-help =
    Informação de Sobreposição:
    - Desactivado O leitor de acesso está desativado
    +Sem restrições O leitor de acesso não tem restrições
    +Set [Index]: [Tag Name] □ Uma tag em um conjunto de acesso (o acessor precisa de todas as tags no conjunto para ser permitido pelo conjunto)
    +Key [StationUid]: [StationRecordKeyId] - A StationRecordKey que é permitido
    -Tag [Tag Name] (uma tag que não é permitida)
cmd-showaccessreaders-status = A sobreposição de depuração do leitor de acesso está definida como { $status }.
