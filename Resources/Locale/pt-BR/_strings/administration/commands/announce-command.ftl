cmd-announce-desc = Envie um anúncio no jogo com cor e som personalizáveis.
cmd-announce-help = {$command} < mensagem> [sender] [color] [sound] - Enviar anúncio. Sender defaults to CentCom, color to Gold, sound to announce.ogg. A cor deve estar em um formato #RRGGBB.

# O remetente padrão para o anúncio
cmd-announce-sender = Comando Central
# Completion hints
cmd-announce-arg-message = <mensagem>
cmd-announce-arg-sender = [sender]
cmd-announce-arg-color = [color]
cmd-announce-arg-sound = [sound]
