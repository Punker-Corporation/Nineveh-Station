    .desc = Жёсткий корпус, исцарапанная линза, злой фокус. Его сделали искать угрозу, а не утешение.
ent-EmptyFlashlightLantern = { ent-FlashlightLantern }
    .suffix = Пустой
    .desc = { ent-FlashlightLantern.desc }
