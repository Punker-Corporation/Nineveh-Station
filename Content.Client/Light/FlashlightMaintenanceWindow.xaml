<ui:FancyWindow xmlns="https://spacestation14.io"
                xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
                SetSize="650 520"
                Title="{Loc 'flashlight-maintenance-window-title'}"
                Resizable="False">
    <BoxContainer Margin="10 8" Orientation="Vertical" SeparationOverride="8">
        <Label Name="StatusLabel" Text="{Loc 'flashlight-maintenance-window-status'}" />
        <TabContainer Name="MaintenanceTabs" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="4" SeparationOverride="8">
                <Label Text="{Loc 'flashlight-maintenance-window-field-note'}" />
                <Label Text="{Loc 'flashlight-maintenance-window-section-optics'}" StyleClasses="LabelKeyText" />
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Text="{Loc 'flashlight-maintenance-window-focus'}" MinWidth="150" />
                    <Slider Name="FocusSlider" MinValue="0" MaxValue="100" HorizontalExpand="True" />
                    <Label Name="FocusValue" Text="0%" MinWidth="52" HorizontalAlignment="Right" />
                </BoxContainer>
                <Label Name="ProjectionLabel" Text="-" />
                <Label Text="{Loc 'flashlight-maintenance-window-section-thermal'}" StyleClasses="LabelKeyText" />
                <ProgressBar Name="HeatBar" MinValue="0" MaxValue="1" HorizontalExpand="True" />
                <Label Name="HeatLabel" Text="-" />
            </BoxContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="4" SeparationOverride="8">
                <Label Text="{Loc 'flashlight-maintenance-window-section-diagnostics'}" StyleClasses="LabelKeyText" />
                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Name="LensLabel" Text="-" MinWidth="250" />
                        <ProgressBar Name="LensBar" MinValue="0" MaxValue="1" HorizontalExpand="True" />
                        <Button Name="LensButton" Text="{Loc 'flashlight-maintenance-window-service'}" MinWidth="86" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Name="EmitterLabel" Text="-" MinWidth="250" />
                        <ProgressBar Name="EmitterBar" MinValue="0" MaxValue="1" HorizontalExpand="True" />
                        <Button Name="EmitterButton" Text="{Loc 'flashlight-maintenance-window-service'}" MinWidth="86" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Name="ContactsLabel" Text="-" MinWidth="250" />
                        <ProgressBar Name="ContactsBar" MinValue="0" MaxValue="1" HorizontalExpand="True" />
                        <Button Name="ContactsButton" Text="{Loc 'flashlight-maintenance-window-service'}" MinWidth="86" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Name="HeatSinkLabel" Text="-" MinWidth="250" />
                        <ProgressBar Name="HeatSinkBar" MinValue="0" MaxValue="1" HorizontalExpand="True" />
                        <Button Name="HeatSinkButton" Text="{Loc 'flashlight-maintenance-window-service'}" MinWidth="86" />
                    </BoxContainer>
                </BoxContainer>
                <Label Name="FaultLabel" Text="-" />
            </BoxContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="4" SeparationOverride="8">
                <Label Text="{Loc 'flashlight-maintenance-window-circuit-note'}" />
                <Label Name="CircuitStepLabel" Text="-" StyleClasses="LabelKeyText" />
                <GridContainer Columns="2" HorizontalExpand="True">
                    <Button Name="ContinuityButton" Text="{Loc 'flashlight-maintenance-action-continuity'}" HorizontalExpand="True" />
                    <Button Name="PolarityButton" Text="{Loc 'flashlight-maintenance-action-polarity'}" HorizontalExpand="True" />
                    <Button Name="CapacitorButton" Text="{Loc 'flashlight-maintenance-action-capacitor'}" HorizontalExpand="True" />
                    <Button Name="GroundButton" Text="{Loc 'flashlight-maintenance-action-ground'}" HorizontalExpand="True" />
                    <Button Name="ResistorButton" Text="{Loc 'flashlight-maintenance-action-resistor'}" HorizontalExpand="True" />
                    <Button Name="EmitterCalButton" Text="{Loc 'flashlight-maintenance-action-emitter'}" HorizontalExpand="True" />
                </GridContainer>
            </BoxContainer>
        </TabContainer>
    </BoxContainer>
</ui:FancyWindow>
