+    private bool TryReserveVoice(Entity<AudioComponent> requesting)
+    {
+        var activeVoices = 0;
+        EntityUid? stealTarget = null;
+        var stealPriority = float.MaxValue;
+        var requestingPriority = GetVoicePriority(requesting.Comp.Params);
+        var query = AllEntityQuery<AudioComponent>();
+
+        while (query.MoveNext(out var uid, out var audio))
+        {
+            if (uid == requesting.Owner || audio.LifeStage >= ComponentLifeStage.Stopping)
+                continue;
+
+            if (audio.State != AudioState.Playing)
+                continue;
+
+            activeVoices++;
+            var priority = GetVoicePriority(audio.Params);
+            if (priority < stealPriority)
+            {
+                stealPriority = priority;
+                stealTarget = uid;
+            }
+        }
+
+        if (activeVoices < PsychoacousticAudioModel.MaxActiveVoices)
+            return true;
+
+        if (stealTarget == null || stealPriority > requestingPriority)
+            return false;
+
+        QueueDel(stealTarget.Value);
+        return true;
+    }
+
+    private static float GetVoicePriority(AudioParams parameters)
+    {
+        if (parameters.BypassMasterCompressor)
+            return 1.1f;
+
+        return PsychoacousticAudioModel.EvaluateSource(
+            parameters.PsychoacousticProfile,
+            parameters.Bus,
+            parameters.AcousticMaterial,
+            parameters.FearIntensity,
+            0f,
+            parameters.ReferenceDistance,
+            parameters.MaxDistance,
+            parameters.RolloffFactor,
+            0f,
+            0f).Priority;
+    }
+
