diff --git a/Robust.Shared.Tests/Audio/PsychoacousticAudioModel_Test.cs b/Robust.Shared.Tests/Audio/PsychoacousticAudioModel_Test.cs
new file mode 100644
index 000000000..1400c8da9
--- /dev/null
