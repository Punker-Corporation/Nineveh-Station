+    private void ApplyPsychoacousticMix(AudioComponent component, float distance, float rawOcclusion)
+    {
+        var parameters = component.Params;
+        var bus = PsychoacousticAudioModel.GetBusDefinition(parameters.Bus);
+        var seconds = (float) Timing.CurTime.TotalSeconds;
+        var audioDistance = GetAudioDistance(distance);
+        var mix = PsychoacousticAudioModel.EvaluateSource(
+            parameters.PsychoacousticProfile,
+            parameters.Bus,
+            parameters.AcousticMaterial,
+            parameters.FearIntensity,
+            audioDistance,
+            GetAudioDistance(parameters.ReferenceDistance),
+            GetAudioDistance(parameters.MaxDistance),
+            parameters.RolloffFactor,
+            rawOcclusion,
+            seconds);
+
+        component.Source.BusGain = SharedAudioSystem.VolumeToGain(bus.GainDb);
+        component.Source.PsychoacousticGain = mix.Gain;
+        component.Pitch = parameters.Pitch * mix.Pitch;
+        component.Occlusion = mix.Occlusion;
+    }
+
+    private static Vector2 GetPsychoacousticPosition(
+        Vector2 listener,
+        Vector2 source,
+        Vector2 delta,
+        float distance,
+        AudioParams parameters)
+    {
+        if (distance <= 0.05f || parameters.Bus is AudioBus.Music or AudioBus.Ambience)
+            return source;
+
+        var spread = PsychoacousticAudioModel.EvaluateSpatialSpread(
+            parameters.PsychoacousticProfile,
+            parameters.Bus,
+            parameters.FearIntensity,
+            distance);
+
+        return listener + delta * spread;
+    }
