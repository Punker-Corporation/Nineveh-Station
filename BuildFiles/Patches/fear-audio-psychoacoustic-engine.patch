@@ -0,0 +1,133 @@
+using NUnit.Framework;
+using Robust.Shared.Audio;
+
+namespace Robust.Shared.Tests.Audio;
+
+[TestFixture]
+public sealed class PsychoacousticAudioModel_Test
+{
+    [Test]
+    public void DistanceGainFallsOffMonotonically()
+    {
+        var near = PsychoacousticAudioModel.EvaluateDistanceGain(1f, 1f, 64f, 1f);
+        var mid = PsychoacousticAudioModel.EvaluateDistanceGain(8f, 1f, 64f, 1f);
+        var far = PsychoacousticAudioModel.EvaluateDistanceGain(32f, 1f, 64f, 1f);
+
+        Assert.Multiple(() =>
+        {
+            Assert.That(near, Is.GreaterThan(mid));
+            Assert.That(mid, Is.GreaterThan(far));
+            Assert.That(far, Is.GreaterThan(0f));
+        });
+    }
+
+    [Test]
+    public void NearFieldGainIsBounded()
+    {
+        var intimate = PsychoacousticAudioModel.EvaluateDistanceGain(0.05f, 1f, 64f, 1f);
+
+        Assert.That(intimate, Is.InRange(1f, 2f));
+    }
+
+    [Test]
+    public void AcousticMaterialsIncreaseOcclusionByAbsorption()
+    {
+        var concrete = PsychoacousticAudioModel.EvaluateOcclusion(1f, AcousticMaterialProfile.Concrete);
+        var carpet = PsychoacousticAudioModel.EvaluateOcclusion(1f, AcousticMaterialProfile.Carpet);
+        var anechoic = PsychoacousticAudioModel.EvaluateOcclusion(1f, AcousticMaterialProfile.Anechoic);
+
+        Assert.Multiple(() =>
+        {
+            Assert.That(concrete, Is.GreaterThan(1.8f));
+            Assert.That(carpet, Is.GreaterThan(concrete));
+            Assert.That(anechoic, Is.GreaterThan(carpet));
+        });
+    }
+
+    [Test]
+    public void ShortVoiceEventsPreserveLocalPlayback()
+    {
+        var preserve = PsychoacousticAudioModel.ShouldPreserveTransientPlayback(
+            PsychoacousticProfile.NonlinearVocalization,
+            AudioBus.Voice,
+            1.4f,
+            false);
+
+        var music = PsychoacousticAudioModel.ShouldPreserveTransientPlayback(
+            PsychoacousticProfile.ProceduralMusic,
+            AudioBus.Music,
+            1.4f,
+            false);
+
+        var longVoice = PsychoacousticAudioModel.ShouldPreserveTransientPlayback(
+            PsychoacousticProfile.NonlinearVocalization,
+            AudioBus.Voice,
+            12f,
+            false);
+
+        Assert.Multiple(() =>
+        {
+            Assert.That(preserve, Is.True);
+            Assert.That(music, Is.False);
+            Assert.That(longVoice, Is.False);
+        });
+    }
+
+    [Test]
+    public void FearProfilesWidenSpatialCueWithoutMovingAmbience()
+    {
+        var threat = PsychoacousticAudioModel.EvaluateSpatialSpread(
+            PsychoacousticProfile.LoomingThreat,
+            AudioBus.Sfx,
+            1f,
+            4f);
+
+        var ambience = PsychoacousticAudioModel.EvaluateSpatialSpread(
+            PsychoacousticProfile.ProceduralMusic,
+            AudioBus.Ambience,
+            1f,
+            4f);
+
+        Assert.Multiple(() =>
+        {
+            Assert.That(threat, Is.GreaterThan(1.1f));
+            Assert.That(ambience, Is.EqualTo(1f).Within(0.1f));
+        });
+    }
+
+    [Test]
+    public void StartleBurstTakesMaximumPriority()
+    {
+        var mix = PsychoacousticAudioModel.EvaluateSource(
+            PsychoacousticProfile.StartleBurst,
+            AudioBus.Sfx,
+            AcousticMaterialProfile.Concrete,
+            0.5f,
+            2f,
+            1f,
+            64f,
+            1f,
+            0f,
+            0f);
+
+        Assert.That(mix.Priority, Is.EqualTo(1f));
+    }
+
+    [Test]
+    public void FearLayerRemainsSubliminalAtDistance()
+    {
+        var mix = PsychoacousticAudioModel.EvaluateSource(
+            PsychoacousticProfile.InfrasoundCarrier,
+            AudioBus.FearLayer,
+            AcousticMaterialProfile.OpenField,
+            1f,
+            4f,
+            1f,
+            64f,
+            1f,
+            0f,
+            0f);
+
+        Assert.That(mix.Gain, Is.LessThan(0.02f));
+    }
+}
