+        private void QueryLightOccluderSegments(Vector2 lightPos, float radius)
+        {
+            _lightVisibilitySegmentQuery.Clear();
+
+            if (_lightOccluderSegments.Count == 0)
+                return;
+
+            if (_lightVisibilitySegmentMarks.Length < _lightOccluderSegments.Count)
+                Array.Resize(ref _lightVisibilitySegmentMarks, _lightOccluderSegments.Count);
+
+            _lightVisibilityQueryStamp++;
+            if (_lightVisibilityQueryStamp == int.MaxValue)
+            {
+                Array.Clear(_lightVisibilitySegmentMarks);
+                _lightVisibilityQueryStamp = 1;
+            }
+
+            var minBucketX = LightingBucketCoordinate(lightPos.X - radius);
+            var maxBucketX = LightingBucketCoordinate(lightPos.X + radius);
+            var minBucketY = LightingBucketCoordinate(lightPos.Y - radius);
+            var maxBucketY = LightingBucketCoordinate(lightPos.Y + radius);
+
+            for (var y = minBucketY; y <= maxBucketY; y++)
+            {
+                for (var x = minBucketX; x <= maxBucketX; x++)
+                {
+                    if (!_lightOccluderSpatialBuckets.TryGetValue(new LightingSpatialBucket(x, y), out var bucket))
+                        continue;
+
+                    for (var i = 0; i < bucket.Count; i++)
+                    {
+                        var segmentIndex = bucket[i];
+                        if (_lightVisibilitySegmentMarks[segmentIndex] == _lightVisibilityQueryStamp)
+                            continue;
+
+                        _lightVisibilitySegmentMarks[segmentIndex] = _lightVisibilityQueryStamp;
+                        _lightVisibilitySegmentQuery.Add(segmentIndex);
+                    }
+                }
+            }
+        }
+
+        private void RebuildLightOccluderSpatialIndex()
+        {
+            var geometryHash = HashLightOccluderGeometry(_lightOccluderSegments);
+            if (geometryHash == _lightOccluderGeometryHash)
+                return;
+
+            _lightOccluderGeometryHash = geometryHash;
+            _lightOccluderGeometryVersion++;
+            _lightVisibilityCache.Clear();
+
+            _lightOccluderSpatialBuckets.Clear();
+
+            if (_lightVisibilitySegmentMarks.Length < _lightOccluderSegments.Count)
+                Array.Resize(ref _lightVisibilitySegmentMarks, _lightOccluderSegments.Count);
+
+            for (var i = 0; i < _lightOccluderSegments.Count; i++)
+            {
+                var segment = _lightOccluderSegments[i];
+                var minX = LightingBucketCoordinate(MathF.Min(segment.A.X, segment.B.X));
+                var maxX = LightingBucketCoordinate(MathF.Max(segment.A.X, segment.B.X));
+                var minY = LightingBucketCoordinate(MathF.Min(segment.A.Y, segment.B.Y));
+                var maxY = LightingBucketCoordinate(MathF.Max(segment.A.Y, segment.B.Y));
+
+                for (var y = minY; y <= maxY; y++)
+                {
+                    for (var x = minX; x <= maxX; x++)
+                    {
+                        var bucketKey = new LightingSpatialBucket(x, y);
+                        if (!_lightOccluderSpatialBuckets.TryGetValue(bucketKey, out var bucket))
+                        {
+                            bucket = new List<int>(8);
+                            _lightOccluderSpatialBuckets.Add(bucketKey, bucket);
+                        }
+
+                        bucket.Add(i);
+                    }
+                }
+            }
+        }
+
+        private LightVisibilityCacheKey CreateLightVisibilityCacheKey(
+            PointLightComponent component,
+            Vector2 lightPos,
+            Angle maskRotation)
+        {
+            return new LightVisibilityCacheKey(
+                _lightOccluderGeometryVersion,
+                FloatBits(lightPos.X),
+                FloatBits(lightPos.Y),
+                FloatBits(component.Radius),
+                FloatBits((float) maskRotation.Theta));
+        }
+
+        private void EvictLightVisibilityCache()
+        {
+            while (_lightVisibilityCache.Count > LightingVisibilityCacheMaxEntries)
+            {
+                var oldestFrame = uint.MaxValue;
+                var oldestKey = default(LightVisibilityCacheKey);
+
+                foreach (var pair in _lightVisibilityCache)
+                {
+                    if (pair.Value.LastUsedFrame >= oldestFrame)
+                        continue;
+
+                    oldestFrame = pair.Value.LastUsedFrame;
+                    oldestKey = pair.Key;
+                }
+
+                _lightVisibilityCache.Remove(oldestKey);
+            }
+        }
