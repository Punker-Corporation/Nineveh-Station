+        private static int LightingBucketCoordinate(float coordinate)
+        {
+            return (int) MathF.Floor(coordinate / LightingSpatialBucketSize);
+        }
+
+        private static int FloatBits(float value)
+        {
+            // Collapse negative zero so cache keys remain stable across equivalent transforms.
+            return BitConverter.SingleToInt32Bits(value == 0f ? 0f : value);
+        }
+
+        private static ulong HashLightOccluderGeometry(List<LightOccluderSegment> segments)
+        {
+            const ulong fnvOffset = 14695981039346656037UL;
+            const ulong fnvPrime = 1099511628211UL;
+
+            unchecked
+            {
+                var hash = fnvOffset;
+                hash = (hash ^ (uint) segments.Count) * fnvPrime;
+
+                for (var i = 0; i < segments.Count; i++)
+                {
+                    var segment = segments[i];
+                    hash = (hash ^ (uint) FloatBits(segment.A.X)) * fnvPrime;
+                    hash = (hash ^ (uint) FloatBits(segment.A.Y)) * fnvPrime;
+                    hash = (hash ^ (uint) FloatBits(segment.B.X)) * fnvPrime;
+                    hash = (hash ^ (uint) FloatBits(segment.B.Y)) * fnvPrime;
+                }
+
+                return hash;
+            }
+        }
+
