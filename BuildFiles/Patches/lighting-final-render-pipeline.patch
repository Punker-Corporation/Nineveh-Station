@@ -598,45 +570,71 @@ namespace Robust.Client.Graphics.Clyde
             PointLightComponent component,
             Vector2 lightPos,
             Angle maskRotation,
+            float distanceSquared,
             GLShaderProgram lightShader)
         {
-            var cacheKey = CreateLightVisibilityCacheKey(component, lightPos, maskRotation);
+            var baseSampleCount = SelectLightVisibilityBaseSamples(component, distanceSquared);
+            var cacheKey = CreateLightVisibilityCacheKey(component, lightPos, maskRotation, baseSampleCount);
             if (_lightVisibilityCache.TryGetValue(cacheKey, out var cached))
             {
                 cached.LastUsedFrame = _lightVisibilityFrameIndex;
-                DrawLightVisibilityVertices(cached.Vertices.AsSpan(), lightShader);
+                DrawLightVisibilityBuffer(cached, lightShader);
                 return;
             }
 
-            BuildExactLightFan(component, lightPos, maskRotation);
+            BuildExactLightFan(component, lightPos, maskRotation, baseSampleCount);
 
             if (_lightVisibilityVertices.Count < 4)
                 return;
 
             var vertices = CollectionsMarshal.AsSpan(_lightVisibilityVertices);
-            _lightVisibilityCache[cacheKey] = new LightVisibilityCacheEntry(vertices.ToArray(), _lightVisibilityFrameIndex);
+            var entry = CreateLightVisibilityCacheEntry(vertices);
+            _lightVisibilityCache[cacheKey] = entry;
             EvictLightVisibilityCache();
 
-            DrawLightVisibilityVertices(vertices, lightShader);
+            DrawLightVisibilityBuffer(entry, lightShader);
         }
 
-        private void DrawLightVisibilityVertices(Span<Vertex2D> vertices, GLShaderProgram lightShader)
+        private LightVisibilityCacheEntry CreateLightVisibilityCacheEntry(Span<Vertex2D> vertices)
         {
-            if (vertices.Length < 4)
+            var vertexArray = new GLHandle(GenVertexArray());
+            BindVertexArray(vertexArray.Handle);
+            CheckGlError();
+
+            ObjectLabelMaybe(ObjectLabelIdentifier.VertexArray, vertexArray, nameof(LightVisibilityCacheEntry));
+
+            var vertexBuffer = new GLBuffer(
+                this,
+                BufferTarget.ArrayBuffer,
+                BufferUsageHint.StaticDraw,
+                MemoryMarshal.AsBytes(vertices),
+                nameof(LightVisibilityCacheEntry));
+            SetupVAOLayout();
+            CheckGlError();
+
+            return new LightVisibilityCacheEntry(vertexArray, vertexBuffer, vertices.Length, _lightVisibilityFrameIndex);
+        }
+
+        private void DrawLightVisibilityBuffer(LightVisibilityCacheEntry entry, GLShaderProgram lightShader)
+        {
+            if (entry.VertexCount < 4)
                 return;
 
-            _lightVisibilityVbo.Reallocate(vertices);
-            BindVertexArray(_lightVisibilityVao.Handle);
+            BindVertexArray(entry.VertexArray.Handle);
             CheckGlError();
 
             lightShader.SetUniformMaybe(UniIModelMatrix, Matrix3x2.Identity);
 
-            GL.DrawArrays(PrimitiveType.TriangleFan, 0, vertices.Length);
+            GL.DrawArrays(PrimitiveType.TriangleFan, 0, entry.VertexCount);
             CheckGlError();
             _debugStats.LastGLDrawCalls += 1;
         }
 
-        private void BuildExactLightFan(PointLightComponent component, Vector2 lightPos, Angle maskRotation)
+        private void BuildExactLightFan(
+            PointLightComponent component,
+            Vector2 lightPos,
+            Angle maskRotation,
+            int baseSampleCount)
         {
             _lightVisibilityVertices.Clear();
             _lightVisibilityAngles.Clear();
@@ -651,9 +649,9 @@ namespace Robust.Client.Graphics.Clyde
             // Base angular samples keep the fan stable when a light has no nearby
             // blockers and bound the maximum triangle size. Endpoint samples below
             // are what make the visibility exact at occluder silhouettes.
-            for (var i = 0; i < LightingCircleSegments; i++)
+            for (var i = 0; i < baseSampleCount; i++)
             {
-                _lightVisibilityAngles.Add(i * LightingTau / LightingCircleSegments);
+                _lightVisibilityAngles.Add(i * LightingTau / baseSampleCount);
             }
 
             QueryLightOccluderSegments(lightPos, radius);
@@ -743,7 +741,7 @@ namespace Robust.Client.Graphics.Clyde
 
             _lightOccluderGeometryHash = geometryHash;
             _lightOccluderGeometryVersion++;
-            _lightVisibilityCache.Clear();
+            ClearLightVisibilityCache();
 
             _lightOccluderSpatialBuckets.Clear();
 
@@ -778,14 +776,54 @@ namespace Robust.Client.Graphics.Clyde
         private LightVisibilityCacheKey CreateLightVisibilityCacheKey(
             PointLightComponent component,
             Vector2 lightPos,
-            Angle maskRotation)
+            Angle maskRotation,
+            int baseSampleCount)
         {
             return new LightVisibilityCacheKey(
                 _lightOccluderGeometryVersion,
                 FloatBits(lightPos.X),
                 FloatBits(lightPos.Y),
                 FloatBits(component.Radius),
-                FloatBits((float) maskRotation.Theta));
+                FloatBits((float) maskRotation.Theta),
+                baseSampleCount);
+        }
+
+        private static int SelectLightVisibilityBaseSamples(PointLightComponent component, float distanceSquared)
+        {
+            // Endpoint rays still preserve exact hard silhouettes. The base ring only
+            // bounds triangle size and the round light perimeter, so it can be scheduled
+            // perceptually without making sealed walls leak.
+            var distance = MathF.Sqrt(distanceSquared + 1f);
+            var salience = component.Radius * MathF.Max(component.Energy, 0.1f) / distance;
+
+            if (component.Radius >= 9f || salience >= 1.6f)
+                return LightingCircleSegments;
+
+            if (component.Radius >= 5f || salience >= 0.55f)
+                return LightingCircleSegmentsMedium;
+
+            return LightingCircleSegmentsLow;
+        }
+
+        private void ClearLightVisibilityCache()
+        {
+            foreach (var entry in _lightVisibilityCache.Values)
+            {
+                DeleteLightVisibilityCacheEntry(entry);
+            }
+
+            _lightVisibilityCache.Clear();
+        }
+
+        private void DeleteLightVisibilityCacheEntry(LightVisibilityCacheEntry entry)
+        {
+            DeleteVertexArray(entry.VertexArray.Handle);
+            entry.VertexBuffer.Delete();
+        }
+
+        private void ShutdownLighting()
+        {
+            ClearLightVisibilityCache();
         }
 
         private void EvictLightVisibilityCache()
@@ -804,7 +842,8 @@ namespace Robust.Client.Graphics.Clyde
                     oldestKey = pair.Key;
                 }
 
-                _lightVisibilityCache.Remove(oldestKey);
+                if (_lightVisibilityCache.Remove(oldestKey, out var entry))
+                    DeleteLightVisibilityCacheEntry(entry);
             }
