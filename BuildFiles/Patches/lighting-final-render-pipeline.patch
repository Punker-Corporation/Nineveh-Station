-                    sizeof(Vertex2D) * LightingVisibilityInitialVertexCapacity,
-                    nameof(_lightVisibilityVbo));
-                GL.BindBuffer(BufferTarget.ArrayBuffer, _lightVisibilityVbo.ObjectHandle);
-                SetupVAOLayout();
-
-                CheckGlError();
-            }
