+                GLHandle vertexArray,
+                GLBuffer vertexBuffer,
+                int vertexCount,
+                uint lastUsedFrame)
             {
-                Vertices = vertices;
+                VertexArray = vertexArray;
+                VertexBuffer = vertexBuffer;
+                VertexCount = vertexCount;
                 LastUsedFrame = lastUsedFrame;
             }
         }
